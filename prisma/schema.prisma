generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BlogArticleFormat {
  SIMPLE
  SUGGESTION
  TOP_10
  GUIDE
  DATA_ANALYSIS
  FACE_TO_FACE
  PORTRAIT
  RETROSPECTIVE
}

model TrendingItem {
  id               String   @id @default(cuid())
  tmdbId           Int
  type             String // "movie" or "tv"
  title            String
  overview         String?
  posterPath       String?
  backdropPath     String?
  popularity       Float?
  voteAverage      Float?
  voteCount        Int?
  releaseDate      String?
  genreIds         Int[]
  originalLanguage String?
  rank             Int
  fetchedAt        DateTime @default(now())

  @@index([type, fetchedAt])
  @@index([tmdbId])
  @@map("trending_items")
}

model BlogArticle {
  id           Int               @id @default(autoincrement())
  format       BlogArticleFormat @default(SIMPLE)
  tmdbId       Int?
  type         String? // "movie" or "tv"
  title        String
  titleFr      String?
  titleEn      String?
  channelTitle String
  posterPath   String?
  viewCount    BigInt?
  countryCount Int?
  weekOf       DateTime
  editorialFr  String            @db.Text
  editorialEn  String            @db.Text
  introFr      String?           @db.Text
  introEn      String?           @db.Text
  conclusionFr String?           @db.Text
  conclusionEn String?           @db.Text
  published    Boolean           @default(true)
  createdAt    DateTime          @default(now())
  items        BlogArticleItem[]

  @@map("blog_articles")
}

model BlogArticleItem {
  id             Int         @id @default(autoincrement())
  articleId      Int
  position       Int
  tmdbId         Int?
  type           String?
  title          String
  channelTitle   String?
  posterPath     String?
  countryCount   Int?
  sectionTitleFr String?
  sectionTitleEn String?
  sectionTextFr  String?     @db.Text
  sectionTextEn  String?     @db.Text
  article        BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, position])
  @@index([tmdbId])
  @@map("blog_article_items")
}
